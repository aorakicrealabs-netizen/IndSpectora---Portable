# Server Runtime Configuration (Localhost Defaults)
PORT=3000
NODE_ENV=development

# APP_URL: Base URL where IndSpectora is accessed (localhost or LAN/Cloud Run URL)
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Optional API key only required if optional AI integrations are added later
GEMINI_API_KEY=""
DISABLE_HMR=true

